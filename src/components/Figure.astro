---
/**
 * A captioned photograph.
 *
 * The chapter's photographs are candid snapshots, mostly 680-800px wide, and
 * they look better honest than stretched. This component caps display width
 * and never blows an image up past its natural size — the legacy home page
 * scaled 1050px banners across a fixed 1047px table and softened every one.
 *
 * `alt` is required, not optional. Every image on the legacy home page carried
 * an empty alt attribute, including the seven carousel slides that were the
 * only navigation on the page.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  /** Cap the rendered width; defaults to the image's natural size. */
  maxWidth?: string;
  /** The source file's actual pixel dimensions — required so the browser can
   * reserve the right space before the image loads (avoids layout shift) and
   * so the figure never renders the image larger than its native resolution,
   * regardless of `maxWidth`. */
  width: number;
  height: number;
}

const { src, alt, caption, credit, maxWidth = '46rem', width, height } = Astro.props;
---

<figure class="figure" style={`--fig-max: ${maxWidth}; --fig-native: ${width}px`}>
  <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  {
    (caption || credit) && (
      <figcaption>
        {caption}
        {credit && <span class="figure__credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: 0;
    /* Never render past the image's own native pixel width, whatever
       `maxWidth` says — a `maxWidth` looser than the source's real
       resolution would otherwise upscale it. */
    max-inline-size: min(var(--fig-max), var(--fig-native));
  }

  .figure img {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--r-md);
    background: var(--c-surface-sunken);
  }

  figcaption {
    margin-block-start: var(--s-3);
    font-size: var(--t-sm);
    line-height: 1.5;
    color: var(--c-ink-faint);
  }

  .figure__credit {
    display: block;
    margin-block-start: var(--s-1);
    font-size: var(--t-xs);
  }
</style>
