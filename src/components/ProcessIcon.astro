---
/**
 * Small line-style icons used across the Foundation, Join Us and Contact Us
 * pages. Deliberately plain stroke outlines — no filled glyphs, no color —
 * so they read as institutional signage rather than illustration, and
 * inherit whatever color the surrounding text uses.
 */
interface Props {
  name:
    | 'donor'
    | 'foundation'
    | 'fund'
    | 'veteran'
    | 'checklist'
    | 'chapter'
    | 'house'
    | 'utility'
    | 'vehicle'
    | 'heart'
    | 'hands'
    | 'clock'
    | 'flag'
    | 'message'
    | 'globe'
    | 'mail'
    | 'letter'
    | 'share';
}

const { name } = Astro.props;
---

<svg
  class="process-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'donor' && (
      <>
        <circle cx="12" cy="8" r="3.2" />
        <path d="M5.5 20c0-4 2.9-6.2 6.5-6.2s6.5 2.2 6.5 6.2" />
      </>
    )
  }
  {
    name === 'foundation' && (
      <>
        <path d="M3 10L12 4l9 6" />
        <path d="M5 10v8M9.3 10v8M14.7 10v8M19 10v8" />
        <path d="M3 20h18" />
      </>
    )
  }
  {
    name === 'fund' && (
      <>
        <ellipse cx="12" cy="7" rx="7" ry="2.5" />
        <path d="M5 7v10c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V7" />
        <path d="M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5" />
      </>
    )
  }
  {
    name === 'veteran' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 6.5l1.5 3.2 3.5.3-2.6 2.4.7 3.5-3.1-1.7-3.1 1.7.7-3.5-2.6-2.4 3.5-.3z" />
      </>
    )
  }
  {
    name === 'checklist' && (
      <>
        <rect x="5" y="4" width="14" height="16" rx="2" />
        <path d="M8 9h8M8 13h4.5" />
        <path d="M8.3 16.3l1.4 1.4 2.8-2.8" />
      </>
    )
  }
  {
    name === 'chapter' && <path d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z" />
  }
  {
    name === 'house' && (
      <>
        <path d="M4 11l8-7 8 7" />
        <path d="M6 10v10h12V10" />
        <path d="M10 20v-6h4v6" />
      </>
    )
  }
  {
    name === 'utility' && <path d="M13 3L5 14h5l-1 7 9-12h-5l1-6z" />
  }
  {
    name === 'vehicle' && (
      <>
        <path d="M4.5 16l1.4-4.8A2 2 0 0 1 7.8 9.8h8.4a2 2 0 0 1 1.9 1.4L19.5 16" />
        <path d="M3.5 16h17v3h-17z" />
        <circle cx="7.5" cy="19.2" r="1.4" />
        <circle cx="16.5" cy="19.2" r="1.4" />
      </>
    )
  }
  {
    name === 'heart' && (
      <path d="M12 20.3s-7.2-4.4-9.4-9.1C1.3 8.4 2.4 5.3 5.4 5c2-.2 3.6 1 4.4 2.6.3.6 1.1.6 1.4 0C12 6 13.6 4.8 15.6 5c3 .3 4.1 3.4 2.8 6.2-2.2 4.7-9.4 9.1-9.4 9.1z" />
    )
  }
  {
    name === 'hands' && (
      <>
        <circle cx="7.5" cy="6.5" r="2.4" />
        <path d="M3.2 18c0-3 1.9-4.7 4.3-4.7s4.3 1.7 4.3 4.7" />
        <circle cx="16.5" cy="6.5" r="2.4" />
        <path d="M12.2 18c0-3 1.9-4.7 4.3-4.7s4.3 1.7 4.3 4.7" />
      </>
    )
  }
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7.5V12l3.2 2" />
      </>
    )
  }
  {
    name === 'flag' && (
      <>
        <path d="M6 3v18" />
        <path d="M6 4.5h12l-2.8 3.5 2.8 3.5H6" />
      </>
    )
  }
  {
    name === 'message' && (
      <>
        <path d="M4 5h16v11H9.5L5 19.5V16H4z" />
        <path d="M8 9h8M8 12h5" />
      </>
    )
  }
  {
    name === 'globe' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <path d="M12 3c2.8 2.4 4.3 5.6 4.3 9s-1.5 6.6-4.3 9c-2.8-2.4-4.3-5.6-4.3-9s1.5-6.6 4.3-9z" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" />
        <path d="M4 6.5l8 6.5 8-6.5" />
      </>
    )
  }
  {
    name === 'letter' && (
      <>
        <rect x="4.5" y="3.5" width="15" height="17" rx="1.2" />
        <path d="M14 4.7v3.6h3.6" />
        <path d="M7.5 13h9M7.5 16.5h6" />
      </>
    )
  }
  {
    name === 'share' && (
      <>
        <circle cx="6" cy="12" r="2.3" />
        <circle cx="17.5" cy="6" r="2.3" />
        <circle cx="17.5" cy="18" r="2.3" />
        <path d="M8.1 10.8l7.4-3.6M8.1 13.2l7.4 3.6" />
      </>
    )
  }
</svg>

<style>
  .process-icon {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    flex-shrink: 0;
  }
</style>
