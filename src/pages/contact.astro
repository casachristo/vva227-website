---
/**
 * Contact.
 *
 * This page exists because the legacy site had no working way to reach the
 * chapter. Its site-wide "Contact" link went to an `email-form` page that
 * returned "Sorry, but the page you requested is not available", and the only
 * functioning email address anywhere on the site belonged to the web vendor.
 */
import PageLayout from '../layouts/PageLayout.astro';
import ContactList from '../components/ContactList.astro';
import ReviewNote from '../components/ReviewNote.astro';
import { addressLine } from '../lib/format';
import site from '../data/site.json';
import contacts from '../data/contacts.json';

const a = site.mailingAddress;
const postal = addressLine([a.line1, a.city, `${a.state} ${a.zip}`]);
---

<PageLayout
  title="Contact"
  description="Reach VVA Chapter 227 by phone, post or Facebook, or contact a specific role directly."
  eyebrow="Get in touch"
  lede="The chapter is run by volunteers, so the fastest route is usually the phone or a meeting."
>
  <div class="primary">
    <div class="primary__card">
      <p class="primary__label">Call</p>
      <p class="primary__value">
        <a href={`tel:${site.phone.replace(/-/g, '')}`}>{site.phone}</a>
      </p>
    </div>
    <div class="primary__card">
      <p class="primary__label">Write</p>
      <address class="primary__value primary__value--sm">
        VVA Chapter 227<br />
        {a.line1}<br />
        {a.city}, {a.state} {a.zip}
      </address>
    </div>
    <div class="primary__card">
      <p class="primary__label">Follow</p>
      <p class="primary__value primary__value--sm">
        <a href={site.facebook} rel="noopener">facebook.com/VVA227</a>
      </p>
    </div>
    <div class="primary__card primary__card--accent">
      <p class="primary__label">Just turn up</p>
      <p class="primary__value primary__value--sm">
        Anyone is welcome at a monthly meeting, including spouses and guests.
        <a href="/events">When and where &rarr;</a>
      </p>
    </div>
  </div>

  <section>
    <h2>Who handles what</h2>
    <ContactList />
  </section>

  <ReviewNote topic="A working contact form">
    <p>
      This mock has no contact form, because the chapter has to decide where submissions should go before one can be
      built. A form on a static site needs a destination — an inbox, or a service that forwards to one.
    </p>
    <p>
      Worth knowing: the legacy site&rsquo;s &ldquo;Member Stories&rdquo; page accepted <strong>file uploads from
      anyone</strong>, gated only by a check that an email address was already on file — which is both a security
      risk and a way to test whether a given person is a member. That endpoint should not be rebuilt as it was.
    </p>
  </ReviewNote>

  <ReviewNote topic="Contact details not republished">
    <p>The current public site publishes the following. They are not carried over here without the chapter&rsquo;s say-so:</p>
    <ul>
      {contacts.withheld.items.map((item) => <li>{item}</li>)}
    </ul>
  </ReviewNote>

  <aside class="crisis-reminder">
    <h2>If you need help now</h2>
    <p>
      The <strong>Veterans Crisis Line</strong> is available 24 hours a day. Dial <a href="tel:988">988</a> then
      press <strong>1</strong>, text <a href="sms:838255">838255</a>, or
      <a href={site.crisis.url} rel="noopener">chat online</a>. Do not wait for the chapter to open.
    </p>
  </aside>
</PageLayout>

<style>
  .primary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: var(--s-4);
  }

  .primary__card {
    padding: var(--s-5);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-block-start: 4px solid var(--c-primary);
    border-radius: var(--r-lg);
  }

  .primary__card--accent {
    border-block-start-color: var(--c-accent);
  }

  .primary__label {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-ink-faint);
  }

  .primary__value {
    margin-block-start: var(--s-3);
    font-family: var(--font-serif);
    font-size: var(--t-xl);
    font-weight: 600;
    font-style: normal;
    line-height: 1.3;
  }

  .primary__value--sm {
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.6;
  }

  section {
    margin-block-start: var(--s-8);
  }

  h2 {
    margin-block-end: var(--s-5);
  }

  .crisis-reminder {
    margin-block-start: var(--s-8);
    padding: var(--s-5) var(--s-6);
    background: color-mix(in srgb, var(--c-crisis) 7%, var(--c-surface));
    border: 1px solid color-mix(in srgb, var(--c-crisis) 28%, var(--c-border));
    border-inline-start: 4px solid var(--c-crisis);
    border-radius: var(--r-md);
  }

  .crisis-reminder h2 {
    font-size: var(--t-lg);
    color: var(--c-crisis);
    margin-block-end: var(--s-3);
  }

  .crisis-reminder p {
    max-width: 62ch;
  }
</style>
