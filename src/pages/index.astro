---
/**
 * Home.
 *
 * Rebuilt 2026-08-28 per the chapter's written direction: a concise, evergreen
 * front door that presents Chapter 227 as active and credible without any
 * figure that needs periodic updating — no membership counts, financial
 * totals, chapter rankings, or meeting schedule. Those live on their own
 * pages (About, Impact, Events) instead, sourced from data that already
 * carries them.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBand from '../components/HeroBand.astro';
import CallToAction from '../components/CallToAction.astro';
import site from '../data/site.json';
---

<BaseLayout
  title="Home"
  description="VVA Chapter 227, the Dean K. Phillips Memorial Chapter, has served veterans and their families across Northern Virginia for decades — guiding veterans to help, honoring those who served, and delivering hope in partnership with the Northern Virginia Vietnam Veterans Foundation."
>
  <!-- ---------- Hero ---------- -->
  <HeroBand
    eyebrow="Veterans Serving Veterans"
    title="We served then. We serve now."
    lede="The Dean K. Phillips Memorial Chapter has served veterans and their families across Northern Virginia for decades. Rooted in the experience of Vietnam veterans, Chapter 227 continues that tradition by helping veterans in need, honoring those who served, and strengthening the veteran community."
    primary={{ label: 'About Chapter 227', href: '/about' }}
    image={{
      src: '/images/memorial-wall-visit.jpg',
      alt: 'Chapter 227 members in their Vietnam Veterans of America vests, viewed from behind, standing before the Vietnam Veterans Memorial Wall with an American flag flying beside them.',
      width: 1050,
      height: 591,
    }}
  />

  <!-- ---------- Quote / transition ---------- -->
  <div class="container">
    <p class="home-motto">&ldquo;{site.motto}.&rdquo;</p>
  </div>

  <!-- ---------- Three pillars ---------- -->
  <section class="section">
    <div class="container">
      <h2 class="section__title">Veterans Helping Veterans</h2>
      <p class="section__lede lede">
        Service has always been at the heart of Chapter 227. Today, that commitment is reflected in three enduring
        principles.
      </p>
      <div class="pillars">
        <article class="pillar">
          <div class="pillar__figure">
            <img class="pillar__icon pillar__icon--compass" src="/images/pillar-compass.png" alt="" width="700" height="467" />
          </div>
          <h3>Guiding Veterans</h3>
          <p>Connecting veterans with the help and resources they need.</p>
        </article>
        <article class="pillar">
          <div class="pillar__figure">
            <img class="pillar__icon pillar__icon--coin" src="/images/pillar-coin.png" alt="" width="700" height="674" />
          </div>
          <h3>Honoring Service</h3>
          <p>Preserving the legacy of those who served.</p>
        </article>
        <article class="pillar">
          <div class="pillar__figure">
            <img class="pillar__icon pillar__icon--stamp" src="/images/pillar-stamp.png" alt="" width="700" height="700" />
          </div>
          <h3>Delivering Hope</h3>
          <p>Helping veterans and families through unexpected hardship.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ---------- Partnership ---------- -->
  <section class="section section--sunken">
    <div class="container">
      <div class="partnership">
        <p class="eyebrow">Chapter 227 &amp; NVVVF</p>
        <h2 class="section__title">Stronger Together</h2>
        <p>
          VVA Chapter 227 and the Northern Virginia Vietnam Veterans Foundation (NVVVF) are independent nonprofit
          organizations working in close partnership to support veterans and their families throughout Northern
          Virginia.
        </p>
        <p class="section__more">
          <a href="/foundation">Learn About Our Partnership &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ---------- Closing ---------- -->
  <div class="container">
    <CallToAction
      title="A Legacy of Service. A Commitment That Continues."
      primary={{ label: 'What We Do', href: '/programs' }}
      secondary={{ label: 'Our Impact', href: '/give/impact' }}
      tone="green"
    >
      Chapter 227 was built on a simple principle: veterans look after veterans. From honoring the service and
      sacrifice of those who came before us to helping veterans and families facing challenges today, that principle
      continues to guide everything we do.
    </CallToAction>
  </div>
</BaseLayout>

<style>
  /* The chapter's motto, moved out from under the hero photo since
     <HeroBand>'s props don't carry a third line of quoted text — this reads
     as the page's own standfirst rather than part of the banner. */
  .home-motto {
    margin-block: var(--s-6) 0;
    padding-inline-start: var(--s-4);
    border-inline-start: 3px solid var(--c-gold);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--t-lg);
    color: var(--c-ink-soft);
    max-width: 40ch;
  }

  /* ---------- Sections ---------- */

  .section__title {
    margin-block-end: var(--s-3);
  }

  .section__lede {
    max-width: var(--w-prose);
    margin-block-end: var(--s-6);
  }

  .section__more {
    margin-block-start: var(--s-6);
    font-weight: 600;
  }

  /* ---------- Three pillars ---------- */

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-7);
    margin-block-start: var(--s-6);
  }

  .pillar {
    text-align: center;
  }

  /* A fixed-height stage per pillar, so the three headings start on the same
     line below regardless of how each graphic's own proportions differ —
     the compass/map is wide, the coin photo carries a lot of its own margin,
     and the stamp is tall. Centering within an equal-height box keeps them
     aligned without cropping or forcing identical image dimensions. */
  .pillar__figure {
    display: flex;
    align-items: center;
    justify-content: center;
    block-size: 10.5rem;
    margin-block-end: var(--s-5);
  }

  .pillar__icon {
    display: block;
    inline-size: auto;
    max-inline-size: 100%;
  }

  /* All three photos are tightly framed around their subject, so an equal
     block-size reads as equal visual weight without any further adjustment. */
  .pillar__icon--compass,
  .pillar__icon--stamp,
  .pillar__icon--coin {
    block-size: 9.5rem;
  }

  .pillar h3 {
    margin-block-end: var(--s-2);
  }

  .pillar p {
    color: var(--c-ink-soft);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* ---------- Partnership ---------- */

  .partnership {
    max-width: var(--w-prose);
  }

  .partnership p {
    margin-block-start: var(--s-4);
  }

  .partnership p:first-of-type {
    margin-block-start: 0;
  }

  @media (max-width: 60rem) {
    .home-motto {
      margin-block-start: var(--s-5);
    }

    .pillars {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }
</style>
