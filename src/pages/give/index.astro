---
/**
 * Ways to Give.
 *
 * Rebuilt 2026-08-31 around two distinct giving PATHS — Chapter 227 itself, or
 * veteran financial assistance through NVVVF — rather than a list of payment
 * methods. PayPal (never independently reconfirmed), Venmo (handle never
 * published as text) and the vehicle/household-goods programs (each described
 * on the legacy site with no phone number, link or form to actually start one)
 * are not carried forward: none of them currently gives a visitor a way to
 * complete a gift. The chapter can add any of them back once it has a
 * confirmed, working way for a donor to follow through. The only Chapter 227
 * giving method with no open question attached — a check by mail — anchors
 * the "Support Chapter 227" path instead.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import HeroBand from '../../components/HeroBand.astro';
import ProcessIcon from '../../components/ProcessIcon.astro';
import { addressLine } from '../../lib/format';
import site from '../../data/site.json';

const a = site.mailingAddress;
const postal = addressLine([a.line1, a.city, `${a.state} ${a.zip}`]);
---

<PageLayout
  title="Ways to Give"
  description="Chapter 227 and the Northern Virginia Vietnam Veterans Foundation offer two distinct ways to support veterans in Northern Virginia."
  hero
>
  <HeroBand
    slot="hero"
    tone="warm"
    eyebrow="Ways to Give"
    title="Support the Mission."
    tagline="Your support helps veterans and sustains the work of Chapter 227."
    lede="Chapter 227 and the Northern Virginia Vietnam Veterans Foundation provide two distinct ways to support veterans and the veteran community across Northern Virginia."
  />

  <!-- ---------- Two Giving Paths ---------- -->
  <section id="giving-paths" class="section paths">
    <div class="container">
      <div class="path-cards">
        <div class="path-card path-card--chapter">
          <div class="path-card__icon">
            <ProcessIcon name="chapter" />
          </div>
          <h2>Support Chapter 227</h2>
          <p class="path-card__lede">Help sustain the organization behind the mission.</p>
          <p>
            Chapter 227 is an all-volunteer organization with no paid staff. Your gift supports chapter programs and
            activities, participation in veteran events, support for other veteran and community organizations,
            necessary operating expenses, and the operating costs of the Northern Virginia Vietnam Veterans
            Foundation (NVVVF).
          </p>
          <a class="path-card__btn" href="#chapter-giving">See How to Give to Chapter 227 &rarr;</a>
        </div>

        <div class="path-card path-card--nvvvf">
          <div class="path-card__icon">
            <ProcessIcon name="foundation" />
          </div>
          <h2>Support Veteran Financial Assistance</h2>
          <p class="path-card__lede">Help a veteran facing financial hardship through NVVVF.</p>
          <p>
            The Northern Virginia Vietnam Veterans Foundation raises funds so that veterans of every era can be
            helped when a sudden financial emergency threatens their stability. Like Chapter 227, NVVVF is entirely
            volunteer-led, with no paid staff. Because Chapter 227 covers the Foundation&rsquo;s operating costs,
            100% of contributions to NVVVF can be devoted to veteran assistance.
          </p>
          <a class="path-card__btn path-card__btn--gold" href="https://nvvvf.org" rel="noopener">
            Give Through NVVVF &rarr;
          </a>
        </div>
      </div>

      <p class="legal-note">
        NVVVF (the Northern Virginia Vietnam Veterans Foundation) is a 501(c)(3) organization, EIN 33-2520012, PO Box
        2111, Reston, VA 20195.
      </p>

      <div class="distinction">
        <p>
          Support Chapter 227 and its broader mission? <a href="#chapter-giving">Give to Chapter 227.</a>
        </p>
        <p>
          Want your contribution devoted specifically to veteran financial assistance?
          <a href="https://nvvvf.org" rel="noopener">Give through NVVVF.</a>
        </p>
        <p class="distinction__more">
          <a href="/give/nvvvf">Learn how the two organizations work together &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ---------- How to Give to Chapter 227 ---------- -->
  <section id="chapter-giving" class="section section--sunken chapter-giving">
    <div class="container">
      <h2>How to Give to Chapter 227</h2>

      <div class="reach-cards reach-cards--pair">
        <div class="reach-card">
          <div class="reach-card__icon">
            <ProcessIcon name="letter" />
          </div>
          <p class="reach-card__label">By Check</p>
          <p class="reach-card__body">Make it out to <strong>VVA Chapter 227</strong> and mail it to:</p>
          <address class="reach-card__address">
            {a.line1}<br />
            {a.city}, {a.state} {a.zip}
          </address>
        </div>

        <div class="reach-card">
          <div class="reach-card__icon">
            <ProcessIcon name="hands" />
          </div>
          <p class="reach-card__label">In Person</p>
          <p class="reach-card__body">
            There is a collection box at every monthly meeting, and the proceeds of the 50/50 drawing go to the same
            fund.
          </p>
          <a class="reach-card__link" href="/events">When and where we meet &rarr;</a>
        </div>
      </div>

      <p class="legal-note">
        VVA Chapter 227 is a {site.taxStatus.designation}, EIN {site.taxStatus.ein}. Contributions are
        tax-deductible to the extent permitted by law. {a.line1}, {a.city}, {a.state} {a.zip}.
      </p>
    </div>
  </section>
</PageLayout>

<style>
  section + section {
    margin-block-start: var(--s-7);
  }

  .container > h2 {
    margin-block-end: var(--s-5);
  }

  .legal-note {
    margin-block-start: var(--s-6);
    max-width: var(--w-prose);
    font-size: var(--t-sm);
    color: var(--c-ink-faint);
  }

  /* ---------- Two giving paths ---------- */

  .path-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
  }

  @media (max-width: 50rem) {
    .path-cards {
      grid-template-columns: 1fr;
    }
  }

  .path-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--s-6);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
  }

  .path-card--chapter {
    border-block-start: 4px solid var(--c-primary);
  }

  .path-card--nvvvf {
    border-block-start: 4px solid var(--c-gold);
  }

  .path-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    margin-block-end: var(--s-4);
    border-radius: 50%;
  }

  .path-card--chapter .path-card__icon {
    background: var(--c-primary-tint);
    color: var(--c-primary);
  }

  .path-card--nvvvf .path-card__icon {
    background: color-mix(in srgb, var(--c-gold) 18%, var(--c-surface));
    color: var(--c-gold);
  }

  .path-card h2 {
    font-size: var(--t-xl);
  }

  .path-card__lede {
    margin-block-start: var(--s-2);
    font-family: var(--font-serif);
    font-size: var(--t-lg);
    color: var(--c-ink-soft);
  }

  .path-card > p:not(.path-card__lede) {
    margin-block-start: var(--s-4);
    max-width: none;
    color: var(--c-ink-soft);
    line-height: 1.6;
  }

  .path-card__btn {
    display: inline-block;
    margin-block-start: var(--s-5);
    padding: var(--s-3) var(--s-5);
    border-radius: var(--r-md);
    background: var(--c-primary);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .path-card__btn:hover {
    background: var(--c-primary-dark);
  }

  .path-card__btn--gold {
    background: var(--c-gold);
    color: var(--c-ink);
  }

  .path-card__btn--gold:hover {
    background: #cd9c4a;
  }

  /* ---------- Distinction callout ---------- */

  .distinction {
    margin-block-start: var(--s-6);
    padding: var(--s-5) var(--s-6);
    background: var(--c-surface-sunken);
    border-radius: var(--r-md);
    text-align: center;
  }

  .distinction p {
    max-width: none;
    font-size: 1.0625rem;
  }

  .distinction p + p {
    margin-block-start: var(--s-2);
  }

  .distinction a {
    font-weight: 700;
  }

  .distinction__more {
    margin-block-start: var(--s-4) !important;
    font-size: var(--t-sm);
  }

  .distinction__more a {
    font-weight: 400;
    color: var(--c-ink-faint);
  }

  /* ---------- How to give to Chapter 227 ---------- */

  .reach-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--s-5);
  }

  .reach-cards--pair {
    max-width: 48rem;
    margin-inline: auto;
  }

  .reach-card {
    padding: var(--s-5);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    text-align: center;
  }

  .reach-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-inline: auto;
    margin-block-end: var(--s-3);
    border-radius: 50%;
    background: var(--c-primary-tint);
    color: var(--c-primary);
  }

  .reach-card__label {
    font-size: var(--t-lg);
    font-weight: 700;
  }

  .reach-card__body {
    margin-block-start: var(--s-2);
    color: var(--c-ink-soft);
    font-size: 1rem;
  }

  .reach-card__address {
    margin-block-start: var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--c-surface-sunken);
    border-radius: var(--r-sm);
    font-style: normal;
    font-weight: 600;
    line-height: 1.5;
  }

  .reach-card__link {
    display: inline-block;
    margin-block-start: var(--s-3);
    font-weight: 700;
    color: var(--c-primary-dark);
  }
</style>
