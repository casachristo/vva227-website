---
/**
 * Impact.
 *
 * Rebuilt 2026-08-29 per the chapter's written direction: replaces the old
 * itemized-ledger/annual-comparison page (dollar tables, membership counts,
 * national rankings, and the unresolved question of how the chapter's own
 * figures relate to the Foundation's) with a page that answers a different
 * question — what difference does the chapter's work actually make — using
 * only evergreen facts that don't require a yearly refresh. The hero image
 * is a temporary placeholder; a new one will be chosen separately.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import HeroBand from '../../components/HeroBand.astro';
import StatRow from '../../components/StatRow.astro';

const glance = [
  { value: '21', label: 'Counties & Independent Cities', note: 'Our Northern Virginia service area' },
  {
    value: '200+',
    label: 'VASH Gift Cards Each Year',
    note: 'Back-to-school and holiday support for veteran families',
  },
  { value: '48 Hours', label: 'Goal for Urgent Assistance', note: 'Moving quickly when a veteran faces a financial crisis' },
  { value: 'Since 1985', label: 'Veterans Serving Veterans', note: 'A tradition of service that continues today' },
];
---

<PageLayout
  title="Impact"
  description="What difference does Chapter 227 make for veterans, families and the Northern Virginia veteran community? Rapid assistance, family support, community partnerships and a legacy carried forward."
  hero
>
  <HeroBand
    slot="hero"
    eyebrow="Our Impact"
    title="Service That Makes a Difference"
    lede="For decades, Chapter 227 has turned the commitment of veterans helping veterans into action—responding to urgent needs, supporting veteran families, strengthening the Northern Virginia veteran community and honoring the legacy of those who served."
    image={{
      src: '/images/impact-veterans-overlook.jpg',
      alt: "Three Vietnam-era veterans overlooking Virginia's Blue Ridge Mountains.",
      width: 1050,
      height: 591,
    }}
  />

  <!-- ---------- Impact at a glance ---------- -->
  <section class="section">
    <div class="container glance">
      <StatRow stats={glance} />
    </div>
  </section>

  <!-- ---------- The four narrative sections, as a 2x2 editorial grid ---------- -->
  <section class="section">
    <div class="container">
      <div class="panel-grid">
        <div class="panel-item">
          <p class="eyebrow">Rapid Assistance</p>
          <h2>When a Veteran Needs Help</h2>
          <p>
            A missed rent payment, utility shutoff or unexpected car repair can quickly become a crisis for a
            veteran or family.
          </p>
          <p>
            Chapter 227 works with trusted veteran-service professionals and the
            Northern Virginia Vietnam Veterans Foundation (NVVVF) to help interrupt that
            chain of events before temporary hardship becomes a lasting crisis.
          </p>
          <p class="emphasis-line">
            The impact isn&rsquo;t simply a bill being paid. It may mean a veteran remains housed, keeps the lights
            on, gets to work or avoids another financial setback.
          </p>
        </div>
        <div class="panel-item">
          <p class="eyebrow">Supporting Families</p>
          <h2>Helping Veteran Families</h2>
          <p>The impact of Chapter 227&rsquo;s work often reaches beyond the veteran.</p>
          <p>
            Through support for families participating in VA Supportive Housing (VASH), Chapter 227 helps parents
            provide school supplies and other necessities for their children and helps veteran families enjoy the
            holiday season with greater security and dignity.
          </p>
          <p>
            Chapter 227 also provides holiday assistance to wounded warrior families facing financial or personal
            challenges.
          </p>
          <p class="emphasis-line">
            Sometimes impact is measured not by dollars, but by a child starting school prepared or a family being
            able to celebrate the holidays together.
          </p>
        </div>
        <div class="panel-item">
          <p class="eyebrow">Community Impact</p>
          <h2>Stronger Together Across Northern Virginia</h2>
          <p>
            Chapter 227&rsquo;s impact extends across a Northern Virginia service area encompassing 21 counties and
            independent cities.
          </p>
          <p>
            That reach is strengthened through relationships with veteran-service professionals, Veterans of
            Foreign Wars and American Legion posts, AVVA, NVVVF and other organizations serving veterans and their
            families.
          </p>
          <p>
            Those relationships matter because no single organization can meet every need. By sharing experience,
            connections and resources, Northern Virginia&rsquo;s veteran community can often accomplish more
            together than any organization could accomplish alone.
          </p>
        </div>
        <div class="panel-item">
          <p class="eyebrow">Beyond the Numbers</p>
          <h2>A Legacy Carried Forward</h2>
          <p>Not every form of impact can be measured in dollars or statistics.</p>
          <p>
            It is found in veterans who remain connected to one another, in friendships strengthened through
            fellowship, in service and sacrifice that continue to be remembered, and in veterans who continue to
            serve their communities long after their military service has ended.
          </p>
          <p>
            Through remembrance, commemorations, fellowship and continued service, Chapter 227 helps carry forward
            the experience and values of the Vietnam veteran generation.
          </p>
          <p class="emphasis-strong">
            One generation of veterans continuing to look after another may be one of the Chapter&rsquo;s most
            enduring forms of impact.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- Closing ---------- -->
  <section class="container">
    <div class="closing">
      <p class="closing__eyebrow">The Mission Continues</p>
      <h2>
        The Needs Change.<br />
        The Commitment Does Not.
      </h2>
      <p class="closing__body">
        Since 1985, Chapter 227 has adapted the ways it serves while holding to a simple principle: veterans
        helping veterans.
      </p>
      <div class="closing__actions">
        <a class="closing__btn closing__btn--solid" href="/programs">What We Do</a>
        <a class="closing__btn closing__btn--ghost" href="/foundation">Foundation</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Was --s-8 (4rem), then --s-7 (3rem) — with the four narrative sections
     now grouped into one panel grid (below) instead of four full-width
     sections in sequence, there are only three section boundaries left on
     the whole page (glance, the grid, the closing). --s-6 (2rem) keeps a
     clear gap at each without reading as dead air. The base .section
     padding-block drops to match, for the same reason — both are existing
     steps on the spacing scale, not one-off values. */
  section + section {
    margin-block-start: var(--s-6);
  }

  .section {
    padding-block: var(--s-6);
  }

  h2 {
    margin-block-end: var(--s-4);
  }

  /* ---------- The four narrative sections, as a 2x2 grid ---------- */

  /* align-items: start lets each panel keep its own height instead of the
     shorter ones stretching to match the tallest in their row. */
  .panel-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
    align-items: start;
  }

  .panel-item {
    padding: var(--s-6);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
  }

  @media (max-width: 48rem) {
    .panel-grid {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
  }

  /* StatRow is a shared component (used elsewhere), so its own defaults stay
     untouched — these :global() overrides apply only within this page's
     "Impact at a glance" band. */
  .glance :global(.stat__value) {
    font-size: var(--t-3xl);
  }

  .glance :global(.stat__label) {
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  p {
    max-width: 78ch;
    font-size: var(--t-base);
    line-height: var(--lh-body);
  }

  p + p {
    margin-block-start: var(--s-4);
  }

  .emphasis-line {
    margin-block-start: var(--s-5);
    max-width: 78ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--t-lg);
    color: var(--c-primary-dark);
  }

  .emphasis-strong {
    margin-block-start: var(--s-5);
    max-width: 78ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--t-xl);
    line-height: 1.35;
    color: var(--c-primary-dark);
  }

  /* ---------- Closing ---------- */

  .closing {
    padding: var(--s-8) var(--s-7);
    background: var(--c-primary);
    border-radius: var(--r-lg);
    color: #fff;
    text-align: center;
  }

  .closing__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-gold);
    margin-block-end: var(--s-3);
  }

  .closing h2 {
    color: #fff;
    font-size: var(--t-2xl);
    line-height: 1.25;
  }

  .closing__body {
    max-width: 46ch;
    margin-inline: auto;
    margin-block-start: var(--s-5);
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    line-height: 1.6;
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-block-start: var(--s-6);
  }

  .closing__btn {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    border-radius: var(--r-md);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .closing__btn--solid {
    background: #fff;
    color: var(--c-primary-dark);
  }

  .closing__btn--solid:hover {
    background: var(--c-surface-sunken);
  }

  .closing__btn--ghost {
    border: 2px solid rgba(255, 255, 255, 0.6);
    color: #fff;
  }

  .closing__btn--ghost:hover {
    background: rgba(255, 255, 255, 0.12);
  }
</style>
