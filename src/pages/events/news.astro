---
/**
 * The Journey — newsletter archive.
 *
 * The legacy page delivered ~120 words inside seven year-grouped <select>
 * dropdowns of raw PDF filenames, where choosing an issue reloaded the page
 * with a query string. Fifty-three entries listed fifty unique files.
 *
 * Here the labels are derived from each filename's YYYYMM stamp, duplicates are
 * removed at render time, and the archive's real gaps are stated rather than
 * hidden behind a dropdown nobody opens.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import DocumentArchive from '../../components/DocumentArchive.astro';
import ReviewNote from '../../components/ReviewNote.astro';
import { parseIssue } from '../../lib/format';
import newsletter from '../../data/newsletter.json';

const current = parseIssue(newsletter.issues[0]);
---

<PageLayout
  title="The Journey"
  description="The archive of The Journey, the newsletter of VVA Chapter 227 — every issue published between 2017 and 2024."
  eyebrow="News"
  lede={`“${newsletter.subtitle}” — the chapter newsletter, carrying the president's letter, the meeting calendar, member news and the speaker line-up.`}
>
  {
    current && (
      <div class="current">
        <p class="current__label">Most recent issue</p>
        <p class="current__issue">{current.label}</p>
        <a class="current__link" href={`${newsletter.baseUrl}${current.file}`} rel="noopener">
          Read it <span>PDF</span>
        </a>
      </div>
    )
  }

  <ReviewNote topic="Is the newsletter still being published?">
    <ul>
      {newsletter.gaps.map((gap) => <li>{gap}</li>)}
    </ul>
    <p>
      The chapter&rsquo;s own publication policy commits to ten issues a year. If the newsletter has paused, the
      site should say so plainly rather than presenting a two-year-old issue as current.
    </p>
  </ReviewNote>

  <h2>Every issue</h2>
  <DocumentArchive files={newsletter.issues} baseUrl={newsletter.baseUrl} label="The Journey newsletter archive" />

  <p class="hosted muted">
    Issues are currently served from the chapter&rsquo;s existing website. They would move across with the rest of
    the site at launch.
  </p>
</PageLayout>

<style>
  .current {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
    padding: var(--s-5) var(--s-6);
    background: var(--c-primary-tint);
    border-radius: var(--r-lg);
    margin-block-end: var(--s-6);
  }

  .current__label {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-primary-dark);
    flex-basis: 100%;
  }

  .current__issue {
    font-family: var(--font-serif);
    font-size: var(--t-2xl);
    font-weight: 700;
    line-height: 1;
    color: var(--c-primary-dark);
  }

  .current__link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-5);
    background: var(--c-primary);
    border-radius: var(--r-md);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
  }

  .current__link:hover {
    background: var(--c-primary-dark);
    color: #fff;
  }

  .current__link span {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    opacity: 0.8;
  }

  h2 {
    margin-block: var(--s-7) var(--s-5);
  }

  .hosted {
    margin-block-start: var(--s-7);
    font-size: var(--t-sm);
  }
</style>
