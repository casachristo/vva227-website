---
/**
 * Annual reports index.
 *
 * Replaces "Presidents Corner", a legacy page whose entire content was a list
 * of five links and which never named the president, showed a photo, or carried
 * a current message. The letters themselves are the chapter's best writing and
 * are migrated intact.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import ReviewNote from '../../../components/ReviewNote.astro';
import { currency, ordinal } from '../../../lib/format';
import impact from '../../../data/impact.json';

const reports = (await getCollection('reports')).sort((a, b) => b.data.year - a.data.year);
const byYear = new Map(impact.years.map((y) => [y.year, y]));
---

<PageLayout
  title="Annual Reports"
  description="The president's annual letters to VVA Chapter 227, 2020 through 2024, with the aid and membership figures behind them."
  eyebrow="About"
  lede="Every year the chapter president writes to the membership about what the year cost, what it achieved, and who spoke at the meetings. Nothing here has been edited."
>
  <ol class="reports">
    {
      reports.map((report) => {
        const figures = byYear.get(report.data.year);
        return (
          <li class="report">
            <div class="report__year">{report.data.year}</div>
            <div class="report__body">
              <h2 class="report__title">
                <a href={`/about/reports/${report.data.year}`}>{report.data.title}</a>
              </h2>
              {report.data.author && <p class="report__author">By {report.data.author}</p>}
              <p class="report__summary">{report.data.summary}</p>
              {figures && (
                <ul class="report__figures">
                  <li>
                    <strong>{currency(figures.totalSupport)}</strong> in direct support
                  </li>
                  <li>
                    <strong>{figures.members}</strong> members
                  </li>
                  {figures.nationalRank && (
                    <li>
                      <strong>{ordinal(figures.nationalRank)}</strong> largest nationally
                    </li>
                  )}
                </ul>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>

  <ReviewNote topic="Missing years">
    The most recent letter covers 2024. There is no 2025 report, and the 2024 letter closes with commitments for
    2025 that were never reported on. A chapter this active should not have its newest public writing be two years
    old.
  </ReviewNote>
</PageLayout>

<style>
  .reports {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .report {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--s-5);
    padding-block: var(--s-6);
    border-block-start: 1px solid var(--c-border);
  }

  .report:first-child {
    border-block-start: none;
    padding-block-start: 0;
  }

  .report__year {
    font-family: var(--font-serif);
    font-size: var(--t-2xl);
    font-weight: 700;
    line-height: 1;
    color: var(--c-gold);
    font-variant-numeric: tabular-nums;
  }

  .report__title {
    font-size: var(--t-xl);
    text-wrap: balance;
  }

  .report__title a {
    color: var(--c-ink);
    text-decoration: none;
  }

  .report__title a:hover {
    color: var(--c-accent-dark);
    text-decoration: underline;
  }

  .report__author {
    margin-block-start: var(--s-2);
    font-size: var(--t-sm);
    color: var(--c-ink-faint);
  }

  .report__summary {
    margin-block-start: var(--s-3);
    max-width: var(--w-prose);
    color: var(--c-ink-soft);
  }

  .report__figures {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    font-size: 1rem;
    color: var(--c-ink-soft);
  }

  .report__figures strong {
    color: var(--c-primary-dark);
  }

  @media (max-width: 44rem) {
    .report {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
    .report__year {
      font-size: var(--t-xl);
    }
  }
</style>
