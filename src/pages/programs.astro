---
/**
 * What We Do.
 *
 * Rebuilt 2026-08-29 per the chapter's written direction: five areas of
 * service, presented in order of scale rather than as five identical cards —
 * emergency financial assistance first and largest, VASH family support
 * next, then Wounded Warrior support, AVVA community service and outside
 * partnerships presented more compactly. Tour of Duty, scholarships, and the
 * older one-off partnerships (MITRE, Suits for Veterans, Operation
 * Kick-Start, the Memorial Day Writers' Project) are retired along with
 * their dollar figures and family counts — none of it is evergreen, and the
 * one vacant contact role (school speakers) had no replacement to offer.
 *
 * Revised 2026-08-29 (second pass): this was a financial-assistance page and
 * needed to also read as a community — added "Serving Northern Virginia
 * Together" (the chapter's reach and its partner organizations) and
 * "Fellowship, Remembrance & Community" (meetings, camaraderie, observances)
 * as two new sections, and enlarged the five-image overview. Everything else
 * — hero, Emergency Assistance, VASH, the compact three, and the closing
 * panel — keeps its existing copy.
 */
import PageLayout from '../layouts/PageLayout.astro';
import HeroBand from '../components/HeroBand.astro';

const overview = [
  {
    image: '/images/overview-emergency.jpg',
    width: 450,
    height: 300,
    alt: 'An envelope stamped PAID in red ink, in front of a folded American flag.',
    heading: 'Emergency Assistance',
    description: 'Rapid help for urgent needs',
  },
  {
    image: '/images/overview-vash.jpg',
    width: 437,
    height: 300,
    alt: 'A backpack filled with school supplies beside a wrapped gift tied with a red ribbon.',
    heading: 'VASH Families',
    description: 'Back-to-school and holiday support for veteran families',
  },
  {
    image: '/images/overview-wounded-warrior.jpg',
    width: 435,
    height: 300,
    alt: 'A wrapped gift tagged "Thank You For Your Service," with a Christmas tree and American flag behind it.',
    heading: 'Wounded Warrior Families',
    description: 'Holiday assistance for military families facing challenges',
  },
  {
    image: '/images/overview-avva.jpg',
    width: 449,
    height: 300,
    alt: 'A box labeled "Caring For Our Community" filled with donated household goods.',
    heading: 'AVVA Community Service',
    description: 'Supporting veterans and neighbors through service and giving',
  },
  {
    image: '/images/overview-community.jpg',
    width: 511,
    height: 300,
    alt: 'A memorial wreath and American flag beside the Vietnam Veterans Memorial Wall.',
    heading: 'Supporting the Veteran Community',
    description: 'Partnerships and contributions that honor veterans and their legacy',
  },
];
---

<PageLayout
  title="What We Do"
  description="Chapter 227 turns commitment into action by helping veterans in need, supporting veteran families, serving our community and honoring those who served."
  hero
>
  <HeroBand
    slot="hero"
    eyebrow="Programs"
    title="What We Do"
    lede="Chapter 227 turns commitment into action by helping veterans in need, supporting veteran families, serving our community and honoring those who served."
    image={{
      src: '/images/coin-map-detail.jpg',
      alt: "A Dean K. Phillips Memorial Chapter 227 challenge coin and a compass resting on a map of the Northern Virginia counties and cities the chapter serves — Fairfax, Arlington, Alexandria, Prince William, and beyond.",
      width: 1050,
      height: 478,
    }}
  />

  <!-- ---------- Five areas of service: visual overview ---------- -->
  <section class="section overview">
    <div class="container container--wide overview__grid">
      {
        overview.map((item) => (
          <div class="overview__item">
            <div class="overview__figure">
              <img src={item.image} width={item.width} height={item.height} alt={item.alt} loading="lazy" decoding="async" />
            </div>
            <p class="overview__heading">{item.heading}</p>
            <p class="overview__description">{item.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ---------- Emergency Financial Assistance + Serving Northern Virginia Together ---------- -->
  <section class="section combo">
    <div class="container">
      <div class="combo__grid">
        <div class="combo__col emphasis-primary">
          <h2>Emergency Financial Assistance</h2>
          <p class="lede">
            Chapter 227 provides rapid financial assistance to Northern Virginia veterans and families facing
            unexpected hardship.
          </p>
          <p>
            Working in close partnership with the <strong>Northern Virginia Vietnam Veterans Foundation (NVVVF)</strong>,
            Chapter 227 helps review requests, verify needs, determine appropriate assistance and arrange approved
            payments directly to creditors.
          </p>
          <p>
            Assistance may help with urgent needs such as housing, utilities, transportation, medical expenses
            and other essentials that can quickly turn a temporary setback into a lasting crisis.
          </p>
          <p class="emphasis-line">
            The goal is simple: get meaningful help to a veteran quickly, often within 48 hours.
          </p>
        </div>
        <div class="combo__col reach">
          <h2>Serving Northern Virginia Together</h2>
          <p>
            Chapter 227&rsquo;s work extends across a broad Northern Virginia region encompassing 21 counties and
            independent cities. That reach depends on strong relationships with veteran-service professionals,
            community organizations and fellow veterans organizations throughout the region.
          </p>
          <p>
            Chapter 227 works with Veterans of Foreign Wars (VFW) and American Legion posts throughout Northern
            Virginia, along with other veteran-serving organizations and community partners. When a veteran is
            facing hardship, those relationships help connect people with resources and, when appropriate, allow
            organizations to work together to provide assistance.
          </p>
          <p class="emphasis-line">
            No single organization can meet every need. By working together, Northern Virginia&rsquo;s veteran
            community can often accomplish more for a veteran or family than any one organization could accomplish
            alone.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- VASH / Wounded Warrior / AVVA / Community (2x2 panels) ---------- -->
  <section class="section">
    <div class="container">
      <div class="panel-grid">
        <div class="panel-item">
          <h3>Supporting Veterans in VA Supportive Housing</h3>
          <p>
            Veteran families working with the VA Supportive Housing (VASH) program sometimes face expenses that go
            beyond the immediate need for housing.
          </p>
          <p>
            Chapter 227 helps those families by providing gift cards for two important times of the year:
            <strong>back-to-school and the holiday season</strong>. The cards help parents provide school supplies
            and other necessities for their children and help ensure that those children can celebrate the holidays
            much like other families.
          </p>
          <p>
            Each year, Chapter 227 provides <strong>at least 200 gift cards</strong> to VASH representatives, who
            distribute them directly to veteran families based on their needs.
          </p>
          <p>Working through VASH protects the privacy of the families while allowing assistance to reach those who need it.</p>
        </div>
        <div class="panel-item">
          <h3>Supporting Wounded Warrior Families</h3>
          <p>
            During the holiday season, Chapter 227 helps support wounded warrior families facing added financial or
            personal challenges.
          </p>
          <p>
            Through holiday assistance and Santa List support, the Chapter helps families focus on what matters
            most &mdash; healing, hope and time together &mdash; while helping ensure that children and families can
            enjoy the season with dignity.
          </p>
        </div>
        <div class="panel-item">
          <h3>Serving Our Community with AVVA</h3>
          <p>
            Associates of Vietnam Veterans of America (AVVA) members affiliated with Chapter 227 play an important
            role in serving veterans and the broader community.
          </p>
          <p>
            Their support includes collecting cash, household goods and other needed items for organizations such as
            <strong>The Lamb Center</strong>, a Fairfax-area day shelter serving people experiencing homelessness,
            including veterans. AVVA members work alongside Chapter members through service, giving, fellowship and
            support for veterans and their families.
          </p>
        </div>
        <div class="panel-item">
          <h3>Supporting the Veteran Community</h3>
          <p>Chapter 227&rsquo;s commitment extends beyond its own activities.</p>
          <p>
            From time to time, the Chapter provides financial or other support to nonprofit organizations and
            initiatives whose work advances veteran services, preserves military history or strengthens the veteran
            community. Organizations supported have included the <strong>Vietnam Veterans Memorial Fund</strong> and
            other veteran-serving charities and initiatives.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- Fellowship, Remembrance & Community ---------- -->
  <section class="section section--sunken fellowship">
    <div class="container">
      <p class="eyebrow">Chapter Life</p>
      <h2>Fellowship, Remembrance &amp; Community</h2>
      <p>
        Chapter 227 is built on relationships formed through shared experience and a continuing commitment to
        service. Members gather regularly not only to conduct Chapter business, but to
        <strong>share a meal, renew friendships and enjoy the camaraderie of fellow veterans</strong>.
      </p>
      <p>
        Chapter meetings often feature guest speakers on topics of interest to veterans and the community.
        Throughout the year, members also come together for activities ranging from the Chapter&rsquo;s annual
        holiday gathering to participation in national VVA meetings and veteran commemorations.
      </p>
      <p>
        Remembrance remains an important part of Chapter life. Members participate in observances including
        National Vietnam War Veterans Day, Memorial Day and Veterans Day, and on occasion join other veterans in
        the tradition of washing the Vietnam Veterans Memorial in Washington, D.C.
      </p>
      <p class="emphasis-line">
        These activities are different from financial assistance, but they reflect the same principle: maintaining
        the bonds among veterans, honoring those who served and carrying the tradition of service forward.
      </p>
    </div>
  </section>

  <!-- ---------- Closing ---------- -->
  <section class="container">
    <div class="closing">
      <h2>
        Guiding Veterans.<br />
        Honoring Service.<br />
        Delivering Hope.
      </h2>
      <p class="closing__body">
        Whether the need is immediate financial assistance, support for veteran families, community service or
        preserving the legacy of those who served, Chapter 227 continues to put experience, compassion and
        commitment into action.
      </p>
      <div class="closing__actions">
        <a class="closing__btn closing__btn--solid" href="/give/impact">Our Impact</a>
        <a class="closing__btn closing__btn--ghost" href="/foundation">Foundation</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Was --s-9 (6rem), then --s-8 (4rem) — the lower half of the page still
     read as too much dead air between sections once Emergency Assistance,
     Serving Northern Virginia Together, VASH, Wounded Warrior, AVVA and
     Community were all full-width narrative blocks stacked in sequence.
     Regrouping them into a two-column section and a 2x2 panel grid (below)
     did most of the compacting; --s-7 (3rem) trims the remaining inter-
     section gap a further 25% without feeling tight, and the base .section
     padding-block drops to match for the same reason — both are existing
     steps on the spacing scale, not one-off values. */
  section + section {
    margin-block-start: var(--s-7);
  }

  .section {
    padding-block: var(--s-7);
  }

  h2 {
    margin-block-end: var(--s-4);
  }

  h3 {
    font-size: var(--t-lg);
    margin-block-end: var(--s-3);
  }

  p {
    max-width: var(--w-prose);
  }

  p + p {
    margin-block-start: var(--s-4);
  }

  /* Emergency Assistance, Serving Northern Virginia Together and VASH were
     reading as narrow text columns stranded in a wide container. A modestly
     wider measure fills more of the available width without stretching into
     an uncomfortable line length. */
  .emphasis-primary p,
  .reach p {
    max-width: 78ch;
  }

  .lede {
    font-size: var(--t-lg);
    color: var(--c-ink-soft);
  }

  .emphasis-line {
    margin-block-start: var(--s-5);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--t-lg);
    color: var(--c-primary-dark);
  }

  /* ---------- Overview ---------- */

  .overview {
    padding-block-start: var(--s-7);
  }

  .overview__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-7) var(--s-6);
  }

  .overview__item {
    flex: 0 1 18rem;
    text-align: center;
  }

  .overview__figure {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--c-surface-sunken);
  }

  .overview__figure img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .overview__heading {
    max-width: none;
    font-size: 1.0625rem;
    font-weight: 700;
    /* Replaces the space the numbered badge used to reserve between the
       image and the heading (a small negative-margin circle overlapping
       the figure's bottom edge) now that the five items are categories,
       not steps, and the badge is gone. */
    margin-block: var(--s-3) var(--s-1);
  }

  .overview__description {
    max-width: none;
    margin-block-start: 0;
    font-size: 1.0625rem;
    color: var(--c-ink-soft);
    line-height: 1.55;
  }

  /* ---------- Hierarchy: primary / combo / panels ---------- */

  .emphasis-primary h2 {
    font-size: var(--t-2xl);
  }

  /* Emergency Assistance and Serving Northern Virginia Together, side by
     side on desktop/tablet. Equal-width columns keep the section reading as
     genuinely balanced; Emergency stays the visually heavier of the two
     through its larger heading size (above) rather than a wider column. */
  .combo__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-8);
  }

  .combo__col + .combo__col {
    padding-inline-start: var(--s-7);
    border-inline-start: 1px solid var(--c-border);
  }

  /* VASH, Wounded Warrior, AVVA and Community as a 2x2 grid of panels
     rather than four more full-width narrative blocks. Real surfaces
     (background, border, radius — the same treatment used for cards
     elsewhere on the site) so they read as substantial panels, not small
     marketing cards; align-items: start lets each panel keep its own
     height instead of stretching the shorter three to match VASH's longer
     copy. */
  .panel-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
    align-items: start;
  }

  .panel-item {
    padding: var(--s-6);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
  }

  .panel-item p {
    /* No font-size override — matches the site's standard 18px/1.65 body
       copy like every other paragraph, not the 16px "captions only" size. */
    max-width: none;
    color: var(--c-ink-soft);
  }

  /* ---------- Closing ---------- */

  .closing {
    padding: var(--s-8) var(--s-7);
    background: var(--c-primary);
    border-radius: var(--r-lg);
    color: #fff;
    text-align: center;
  }

  .closing h2 {
    color: #fff;
    font-size: var(--t-2xl);
    line-height: 1.25;
  }

  .closing__body {
    max-width: 46ch;
    margin-inline: auto;
    margin-block-start: var(--s-5);
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    line-height: 1.6;
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-block-start: var(--s-6);
  }

  .closing__btn {
    display: inline-block;
    padding: var(--s-3) var(--s-5);
    border-radius: var(--r-md);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .closing__btn--solid {
    background: #fff;
    color: var(--c-primary-dark);
  }

  .closing__btn--solid:hover {
    background: var(--c-surface-sunken);
  }

  .closing__btn--ghost {
    border: 2px solid rgba(255, 255, 255, 0.6);
    color: #fff;
  }

  .closing__btn--ghost:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  /* Stack both new grids on phones while keeping them multi-column through
     tablet widths — 48rem sits at a typical tablet-portrait/phone boundary,
     narrower than the 64rem the old three-column prose grid needed (a
     bordered, padded panel tolerates a narrower column far better than
     flowing text does). */
  @media (max-width: 48rem) {
    .combo__grid {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }

    .combo__col + .combo__col {
      padding-inline-start: 0;
      border-inline-start: none;
      padding-block-start: var(--s-6);
      border-block-start: 1px solid var(--c-border);
    }

    .panel-grid {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
  }

  @media (max-width: 30rem) {
    .overview__item {
      flex-basis: 100%;
      max-inline-size: 20rem;
    }
  }
</style>
