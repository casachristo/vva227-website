# Security and caching headers for Cloudflare Pages.
#
# The legacy site sent none of these. It also served an inline jQuery reload
# loop and eight third-party scripts, so a strict CSP would have been
# impossible there. Here every asset is same-origin — fonts included — so the
# policy can be tight.

/*
  # No third-party anything. 'unsafe-inline' for styles only, because Astro
  # inlines small component stylesheets at build time. No script-src allowance
  # is needed: this site ships zero JavaScript.
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprinted build assets never change under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs and documents change rarely; a day is a reasonable compromise
# for a site edited a few times a month.
/images/*
  Cache-Control: public, max-age=86400
/docs/*
  Cache-Control: public, max-age=86400
